cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pkl
*.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/

# MacOS
.DS_Store

# Jupyter
.ipynb_checkpoints/

# VSCode / JetBrains
.vscode/
.idea/

# Logs and reports
*.log

# paper for now
paper/*

src/*.egg-info/
# results - benchmarking outputs
# results/benchmark/*.csv
*.md
